# ==============================================
# CloudCost AI - Backend Environment Template
# ==============================================
# Copy this file to .env for local overrides if needed:
# cp .env.example .env

PROJECT_NAME="CloudCost AI Backend"
ENVIRONMENT="development"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (Comma-separated for simplicity in .env or JSON list)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Database Connection
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>
# For local development on macOS with Homebrew:
# DATABASE_URL="postgresql://<your-username>@localhost:5432/cloudcost_ai"
# For Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloudcost_ai"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloudcost_ai"

# JWT Authentication Secrets
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM / AI Provider Configuration
# Set your OpenAI API key below (e.g. sk-proj-...)
# If unset or left as placeholder, the system gracefully reports unconfigured status
OPENAI_API_KEY="replace-with-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
LLM_TIMEOUT_SECONDS=30

# RAG & Embedding Configuration
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536

# Redis Queue & Background Worker Configuration
# Format: redis://[:password@]host:port/db
REDIS_URL="redis://localhost:6379/0"
