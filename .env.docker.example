# ==============================================================================
# CloudCost AI - Docker Compose Environment Configuration Template
# ==============================================================================
# Copy this file to .env before running `docker compose up`:
#   cp .env.docker.example .env
#
# Docker Compose will automatically read variables defined in .env

# Application Environment (development | production)
ENVIRONMENT=production

# PostgreSQL Credentials & Database Name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cloudcost_ai

# JWT Secret Key (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars

# OpenAI API Key (Optional: for AI billing explainer and pgvector embeddings)
# If left empty, system operates gracefully in keyword fallback mode
OPENAI_API_KEY=

# Public API URL reachable from your web browser
# (Your browser on host cannot resolve Docker internal service names like http://backend:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

